// Cloudflare Workers config for cmm.dev.
// Workers Builds Git integration runs `bun run build` then `wrangler deploy`,
// which uploads ./dist as static assets.
// Local/manual deploys inject CLOUDFLARE_API_TOKEN from 1Password
// (`bun run deploy:op`). Optional GitHub Actions deploy uses the same
// wrangler.jsonc (never Pages) and the same op:// reference.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmm-dev",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    // /viz/ -> /viz/index.html, /foo -> /foo.html or /foo/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
